  npcName: Old Man
  npcPortrait: {fileID: -1370704580282894982, guid: 5fd35a4814146483ebba82f851447993, type: 3}
  dialogueLines:
  - "Sei gegr\xFC\xDFt, junger Reisender. Man nennt mich einfach \"Old Man\""
  - 'Bewegen kannst du dich mit W, A, S und D. '
  - "Das Schwert dort rechts geh\xF6rt dir. Mit der Leertaste kannst du es schwingen."
  - "Weiter oben im Norden findest du einen Laden. Dr\xFCcke dort E, um einzutreten."
  - "Merke dir: Der rote Trank heilt deine Wunden. Das Buch erh\xF6ht deine maximale
    Lebenskraft."
  - "Dr\xFCcke M, um das Men\xFC zu \xF6ffnen. Dort findest du: Player, Settings
    und Inventory."
  - Im Inventory hast du deine Items. Du kannst sie im Shop verkaufen oder neue Items
    kaufen.
  - Hinter mir im Westen ist das Portal zur Kampfwelt.
  - "Dort kannst du Gegner mit deinem Schwert t\xF6ten."
  - "Sie lassen Coins fallen. Kaufe dir davon im Shop Upgrades f\xFCr dein Leben."
  - "Vorsicht: Die Gegner werden automatisch st\xE4rker, je l\xE4nger du spielst."
  - "Viel Spa\xDF ;)"
  autoProgressLines: 010101010101010101010100
  autoProgressDelay: 2.5
  typingSpeed: 0.06
  voiceSound: {fileID: 0}
  voicePitch: 1
